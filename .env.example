# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Compose auto-loads `.env` (not `.env.local`).

# ─── required ──────────────────────────────────────────────────────────────

# Better Auth session secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public URL the app is reachable at. Used both server-side (cookies,
# OAuth redirect targets) and baked into the client bundle at build time.
# For local docker: http://localhost:3000
# For prod: https://your-domain.example
BETTER_AUTH_URL=http://localhost:3000

# ─── optional ──────────────────────────────────────────────────────────────

# Host port to expose. Default 3000.
# HOST_PORT=3000

# Google Calendar integration. Leave blank if you don't want it — the
# calendar panel will just show "not connected" until you fill these in.
# Get them from console.cloud.google.com → APIs & Services → Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
